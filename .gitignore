# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env
.env.local

# Database
data/

# 서버에서 install-lang 으로 설치한 언어 (용량이 커서 저장소에 올리지 않는다)
langs/
*.db
*.sqlite3

# Installers and binary packages
*.exe
*.msi
Docker Desktop*

# Logs
*.log

# OS generated files
Thumbs.db
.DS_Store

# IDEs
.vscode/
.idea/

# 로컬 실행 환경
.venv/
.claude/
*.pyc

# 비공개 키·인증서는 절대 올리지 않기
*.pem
*.key
*.p12

# 서버 데이터 백업 폴더(DB 포함)는 절대 올리지 않는다
data_backup*/
